<!DOCTYPE html>
        <html lang="en">
        <head>
            <!-- your header here -->
        </head>
        <body>
            <nav><!-- your nav here --></nav>
            <div class="container">
                <h1>Edit Profile</h1>
                <form action="/profile/edit" method="POST">
                    <div>
                        <label for="name">Name</label>
                        <input type="text" id="name" name="name" value="<%= profile.name %>">
                    </div>
                    <div>
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" value="<%= profile.email %>">
                    </div>
                    <div>
                        <label for="age">Age</label>
                        <input type="number" id="age" name="age" value="<%= profile.age %>">
                    </div>
                    <div>
                        <label for="student">Is a student?</label>
                        <input type="radio" id="no" name="student" value="true">
                        <label for="yes">Yes</label>
                        <input type="radio" id="no" name="student" value="false">
                        <label for="no">No</label>
                    </div>
                    <div>
                        <label for="bio">Bio</label>
                        <textarea id="bio" name="bio"><%= profile.bio %></textarea>
                    </div>
                    <button type="submit">Save</button>
                </form>
            </div>
        </body>
    </html>